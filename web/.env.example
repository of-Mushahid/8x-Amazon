# Copy to .env.local and provide your own Supabase project values.
# Nothing is provisioned automatically; persisted features return HTTP 503 until configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternatively use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead of the anon key.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER/SEED ONLY. Never prefix this key with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Apply supabase/migrations/001_store.sql to your own project before seeding.
# Native TypeScript runner, Node >=22.18:
# node --env-file=.env.local scripts/seed.ts
# Seed uploads public/images/products/*.webp and resets the demo catalog inventory.
# Supabase Auth: allow http://localhost:3000/auth/callback and your deployed HTTPS callback.
# Authentication uses Supabase's PKCE callback; no real payment provider is used.
# Guest receipts are HttpOnly, order-path-scoped cookies, available for 30 days in this browser.
# Keep the same idempotencyKey for retries; use a new key after changing checkout details.
